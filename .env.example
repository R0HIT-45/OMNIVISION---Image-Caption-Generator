# ============================================================
# OmniVision v1.0 — Environment Configuration
# ============================================================
# Copy this file to .env and adjust values as needed.
# ============================================================

# === Deployment Profile ===
# Options: development | demo | production
# development = BLIP Base (CPU-friendly, ~900MB VRAM)
# demo        = BLIP-2 4-bit (requires CUDA, ~1.8GB VRAM)
# production  = BLIP-2 4-bit (same as demo, future expansion)
PROFILE=development

# === API Server ===
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
API_BASE_URL=http://localhost:8000/api/v1

# === AI Models ===
# Defaults are set by PROFILE. Uncomment to override.
# BLIP_MODEL is set dynamically based on PROFILE:
#   - development: Salesforce/blip-image-captioning-base
#   - demo/production: Salesforce/blip2-opt-2.7b
# BLIP_MODEL=Salesforce/blip-image-captioning-base
CLIP_MODEL=openai/clip-vit-base-patch32
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# === Visual RAG Configuration ===
GROUNDING_SIMILARITY_THRESHOLD=0.75
ACTIVE_KNOWLEDGE_PACKS=["heritage_pack"]

# === File Paths ===
UPLOAD_DIR=static/uploads
AUDIO_DIR=static/audio
KNOWLEDGE_BASE_DIR=knowledge_base

# === Limits ===
MAX_UPLOAD_SIZE_MB=10
